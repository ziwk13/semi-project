# 로컬 개발용 실제 설정 값. 이 파일은 .gitignore 에 의해 커밋되지 않는다.
# application-secret.properties.example 를 복사해서 값만 채워 사용한다.

# ===== Database (MySQL) =====
db.url=jdbc:mysql://localhost:3306/db_puppit?serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
db.username=root
db.password=CHANGE_ME

# ===== Kakao OAuth =====
kakao.rest.api.key=CHANGE_ME
kakao.redirect.uri=http://localhost:8080/puppit/auth/kakao/callback

# ===== Iamport / PortOne =====
iamport.api.key=CHANGE_ME
iamport.api.secret=CHANGE_ME

# ===== AWS S3 =====
# 자격증명은 환경변수(AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION)로 주입
aws.s3.bucket=CHANGE_ME
